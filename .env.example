# Bat buoc: khoa ky JWT. Tao bang: openssl rand -hex 32
SOCHI_SECRET=

# Cong lang nghe. Dung 8080 vi Cloudflare Worker chi proxy duoc mot so cong nhat dinh.
PORT=8080
HOST=0.0.0.0

# Thu muc chua sochi.db
SOCHI_DATA=/home/hoang/sochi-data

# Cho phep dang ky them tai khoan sau khi da co tai khoan dau tien (1 = cho phep)
ALLOW_REGISTER=0

# Doc hoa don. Lay key mien phi tai https://aistudio.google.com/apikey
# LUU Y: Google khai tu model cu kha nhanh. Neu log bao 404 "no longer available",
# doi GEMINI_MODEL sang ten model moi ma thong bao loi goi y.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Nhac han qua Telegram. De trong thi chi nhac trong app.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Bat buoc khi dung Cloudflare Worker proxy. Tao bang: openssl rand -hex 32
# Gia tri nay phai giong het secret PROXY_SECRET dat trong Worker.
# De trong = tat kiem tra, may chu nhan moi request (chi dung khi test noi bo).
PROXY_SECRET=
